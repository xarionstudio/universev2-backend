# Staging environment
APP_NAME=universev2-backend
APP_ENV=staging
APP_PORT=8080
APP_URL=https://staging.example.com

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_NAME=universev2
DB_SSLMODE=require
DB_MAX_POOL_SIZE=25
DB_MIN_POOL_SIZE=5

# JWT
JWT_SECRET=replace-with-a-strong-secret-for-staging
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h


FINGERPRINT_ENABLED=false

# CORS
CORS_ALLOWED_ORIGINS=https://staging.example.com

# Logging
LOG_LEVEL=info