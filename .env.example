# ──── Application ────
APP_NAME=universev2-backend
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# ──── Database ────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=universev2
DB_SSLMODE=disable
DB_MAX_POOL_SIZE=25
DB_MIN_POOL_SIZE=5

# ──── JWT ────
JWT_SECRET=xxcXfZH1kaSiAwiO7wluFSjfYp8fj5+AbMvdssfEfT0xRtFXrpsA7H/I5BGnpMf1
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# ──── Fingerprint ────
FINGERPRINT_PORT=/dev/ttyUSB0
FINGERPRINT_BAUD=115200
FINGERPRINT_ENABLED=false

# ──── CORS ────
CORS_ALLOWED_ORIGINS=http://localhost:3000

UPLOAD_DIR=uploads

# Migrations
MIGRATIONS_DIR=migrations

# ──── Logging ────
LOG_LEVEL=debug