### 08. Settings, Notifications & TV Display API Requests
@baseUrl = http://localhost:8080
@authToken = {{login.response.body.data.token}}

# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "angel@unggul.co.id",
  "password": "admin123"
}

### Get Notifications
GET {{baseUrl}}/api/v1/notifications/
Authorization: Bearer {{authToken}}

### Get Settings
GET {{baseUrl}}/api/v1/settings/
Authorization: Bearer {{authToken}}

### Get Display Devices
GET {{baseUrl}}/api/v1/settings/displays
Authorization: Bearer {{authToken}}

### Get Fingerprint Devices
GET {{baseUrl}}/api/v1/fingerprint/devices
Authorization: Bearer {{authToken}}
