### 02. Karyawan (Employees) API Requests
@baseUrl = http://localhost:8080
@authToken = {{login.response.body.data.token}}

# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "angel@unggul.co.id",
  "password": "admin123"
}

### Get All Employees
GET {{baseUrl}}/api/employees/
Authorization: Bearer {{authToken}}

### Get Employee by NIK
GET {{baseUrl}}/api/employees/503264133
Authorization: Bearer {{authToken}}

### Create New Employee
POST {{baseUrl}}/api/employees/
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "nik": "503264999",
  "name": "Budi Karyawan Baru",
  "dept": "Operation",
  "pos": "Operator Dump Truck",
  "company": "PT Unggul Dinamika Utama",
  "status": "aktif"
}

### Update Employee
PUT {{baseUrl}}/api/employees/503264999
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Budi Karyawan Edit",
  "status": "aktif"
}

### Delete Employee
DELETE {{baseUrl}}/api/employees/503264999
Authorization: Bearer {{authToken}}
